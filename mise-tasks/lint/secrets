#!/usr/bin/env bash
#MISE description="Scan the files git would commit for secrets (gitleaks, redacted)"
set -euo pipefail
cd "$(dirname "$0")/../.."
root=$PWD
# Scan exactly what git would commit: tracked plus untracked-not-ignored files.
# Gitignored paths (agent worktrees, .venv, caches) are never scanned.
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
# A path that vanishes between the listing and its copy (parallel lint tasks write
# transient files) is skipped; any other copy failure still fails the task.
while IFS= read -r -d '' f; do
  if [ ! -e "$f" ] && [ ! -L "$f" ]; then continue; fi
  mkdir -p "$stage/$(dirname "$f")"
  if ! cp -RP "$f" "$stage/$f" 2>/dev/null; then
    if [ -e "$f" ] || [ -L "$f" ]; then
      echo "[lint:secrets] cannot copy $f" >&2
      exit 1
    fi
  fi
done < <(git ls-files -coz --exclude-standard)
gitleaks dir "$stage" --redact --no-banner --config "$root/.gitleaks.toml"
