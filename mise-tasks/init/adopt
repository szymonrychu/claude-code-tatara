#!/usr/bin/env bash
#MISE description="Adopt an existing checkout (--path, moved in place) or repo (--url) as a component (init_engine adopt)"
set -euo pipefail
# relative --path and --remote local-bare:<dir> resolve against where the user ran the task
export INIT_ENGINE_CWD="${MISE_ORIGINAL_CWD:-$PWD}"
cd "$(dirname "$0")/../.."
exec python3 scripts/init_engine/cli.py adopt "$@"
