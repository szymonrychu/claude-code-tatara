{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 plugins/core/hooks/adapter.py --harness codex --event pre-tool --hook guard-bash"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|MultiEdit|NotebookEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 plugins/core/hooks/adapter.py --harness codex --event pre-tool --hook protect-files"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 plugins/core/hooks/adapter.py --harness codex --event stop --hook subagent-commit-guard"
          }
        ]
      }
    ]
  }
}
